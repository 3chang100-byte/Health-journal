# 1) 검색·데이터랩 — https://developers.naver.com/apps 에서 애플리케이션 등록
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 2) 카페 글쓰기 — 같은 애플리케이션에 "네이버 로그인" + "카페" 권한 추가 후 `npm run auth` 로 발급
NAVER_ACCESS_TOKEN=
NAVER_REFRESH_TOKEN=

# 3) 스마트스토어 — https://apicenter.commerce.naver.com 에서 애플리케이션 등록 (호출 IP 등록 필요)
NAVER_COMMERCE_CLIENT_ID=
NAVER_COMMERCE_CLIENT_SECRET=

# 4) 지도 — https://console.ncloud.com 의 Maps (Geocoding, Reverse Geocoding, Directions 5)
NCP_MAPS_KEY_ID=
NCP_MAPS_KEY=
